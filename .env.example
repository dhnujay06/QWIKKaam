# Environment Variables for Qwikkaam
# ⚠️ IMPORTANT: Copy this file to .env and fill in your actual values
# ⚠️ NEVER commit .env to GitHub

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Get a free PostgreSQL DB at: https://supabase.com
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/qwikkaam?schema=public"

# ─── NEXTAUTH ─────────────────────────────────────────────────────────────────
# Generate a secret: run `openssl rand -base64 32` in terminal
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Admin password (use a long, random value; keep it out of source control)
ADMIN_PASSWORD="replace-with-a-long-random-password"

# ─── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Qwikkaam"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Service area restriction
NEXT_PUBLIC_ACTIVE_CITY="Bhilai"
NEXT_PUBLIC_ACTIVE_AREA="Risali Sector"
NEXT_PUBLIC_ACTIVE_PINCODE="490006"
