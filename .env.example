# Environment Variables for Qwikkaam
# ⚠️ IMPORTANT: Copy this file to .env and fill in your actual values
# ⚠️ NEVER commit .env to GitHub

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Get a free PostgreSQL DB at: https://supabase.com
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/qwikkaam?schema=public"

# ─── NEXTAUTH ─────────────────────────────────────────────────────────────────
# Generate a secret: run `openssl rand -base64 32` in terminal
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Admin password (use a long, random value; keep it out of source control)
ADMIN_PASSWORD="replace-with-a-long-random-password"

# ─── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Qwikkaam"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Service area restriction
NEXT_PUBLIC_ACTIVE_CITY="Bhilai"
NEXT_PUBLIC_ACTIVE_AREA="Risali Sector"
NEXT_PUBLIC_ACTIVE_PINCODE="490006"

# ─ NOTIFICATIONS (MSG91 — WhatsApp + SMS) ───────────────────────────────────────────
# Signup free at: https://msg91.com
# Dashboard > Settings > Auth Key
MSG91_AUTH_KEY="your-msg91-auth-key-here"

# 6-character sender ID (approved by DLT/TRAI)
MSG91_SENDER_ID="QWIKKM"

# WhatsApp Business sender number (e.g. 917771234567)
MSG91_WA_SENDER="91XXXXXXXXXX"

# Admin WhatsApp number to receive new booking alerts (e.g. 9876543210)
ADMIN_PHONE="9876543210"

# Notification language: "hi" (Hindi) or "en" (English)
NOTIFICATION_LANG="hi"

# ─ CONTACT FORM EMAIL (Nodemailer / Gmail SMTP) ──────────────────────────────
# Use Gmail App Password (not your real password): https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-gmail-app-password"
CONTACT_EMAIL="support@qwikkaam.com"
